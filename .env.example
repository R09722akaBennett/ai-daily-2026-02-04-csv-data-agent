# Environment
ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_PATH=/api

# UI
UI_API_URL=http://127.0.0.1:8000

# Project
PROJECT_NAME=KDoc IDP
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Storage — uploaded files + extraction artifacts (gitignored)
DATA_DIR=./data
MAX_UPLOAD_MB=50

# Demo mode: serves a pre-baked extraction so the UI is interactive
# even without Docling installed. Flip to false in production.
DEMO_MODE=true

# Docling pipeline knobs — only consumed when [extract] extra is installed.
# Toggle table extraction model (heaviest model, but THE differentiator).
DOCLING_DO_TABLE_STRUCTURE=true
# Toggle OCR (turns on for scanned PDFs / image inputs).
DOCLING_DO_OCR=true
# Page count cap to keep UX predictable on huge docs.
DOCLING_MAX_PAGES=200

# RAG chunker
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
