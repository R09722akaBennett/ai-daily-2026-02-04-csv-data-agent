# Environment
ENV=dev
LOG_LEVEL=INFO

# API
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_PATH=/api

# UI
UI_API_URL=http://127.0.0.1:8000

# Project-specific
PROJECT_NAME=Crypto Agent Research
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Anthropic — required to run cycles
ANTHROPIC_API_KEY=

# Agent models (override per-role to compare cost / quality)
SCOUT_MODEL=claude-haiku-4-5
ANALYST_MODEL=claude-sonnet-4-6
TRADER_MODEL=claude-opus-4-7
RISK_MODEL=claude-haiku-4-5
REFLECTOR_MODEL=claude-opus-4-7

# Memory / data files (JSONL append-only)
DATA_DIR=./data

# Binance public REST
BINANCE_BASE_URL=https://api.binance.com

# Paper portfolio
PAPER_STARTING_BALANCE_USD=1000
